<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stiker dan efek filter diunduh dari internet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- configChanges: hasil edit tetap utuh saat layar diputar atau tema berubah. -->
        <activity
            android:name="com.zinmedia.photoeditor.ImageEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="com.zinmedia.photoeditor.PhotoEditorFileProvider"
            android:authorities="${applicationId}.zinmedia.photoeditor.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <!-- Wajib: FileProvider.getUriForFile() membaca daftar folder dari meta-data ini. -->
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/zm_photoeditor_file_paths" />
        </provider>
    </application>

</manifest>
